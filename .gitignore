# Created by Kiro - Production Configuration
# Global gitignore for GFM Mobile Source monorepo

# Dependencies
# NOTE: lockfiles (yarn.lock, package-lock.json) are intentionally tracked
# so installs are reproducible.
node_modules/

# Environment variables (keep *.example templates tracked)
.env
.env.*
!.env.example
!.env.*.example

# Secrets and signing material
*.pem
*.key
*.p12
*.keystore
*.jks

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Build outputs
dist/
build/
.next/
out/
.expo/
.expo-shared/
.gradle/
.m2/
android/app/.cxx/
android/build/

# Testing
coverage/
.nyc_output/
*.lcov

# Logs
logs/
*.log
*-logcat.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
activity-*.txt
camera-*.txt

# OS
Thumbs.db
.DS_Store

# Mobile specific
android/app/debug.keystore
android/app/release.keystore
ios/Pods/
ios/Podfile.lock

# Temporary files
*.tmp
*.temp
.cache/

# Video editor specific
*.mp4
*.mov
*.avi
*.mkv
temp_videos/
exported_videos/

# Sentry
.sentry/

# Misc
.turbo/
*.apk
*.aab
*.ipa
build-*.apk

# Build artifacts and screenshots
ios/build/
android/app/build/
.cxx/
screenshot*.png
screen.png
cam-shot*.png
app_screenshot*.png
