{
  "expo": {
    "name": "Gully Fame",
    "slug": "gully-fame-mobile",
    "version": "1.0.0",
    "backgroundColor": "#000000",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "gullyfamemobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "backgroundColor": "#3C2610",
      "supportsTablet": false,
      "bundleIdentifier": "com.gullyfame.mobile",
      "buildNumber": "1",
      "icon": "./assets/images/app-icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "backgroundColor": "#000000",
      "versionCode": 1,
      "package": "com.gullyfame.mobile",
      "icon": "./assets/images/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-adaptive-foreground.png",
        "backgroundColor": "#161616"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "@react-native-google-signin/google-signin",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Gully Fame to use your location to show contests and creators near you."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Gully Fame to access your camera to record videos.",
          "microphonePermission": "Allow Gully Fame to access your microphone to record audio.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Gully Fame to access your photos.",
          "savePhotosPermission": "Allow Gully Fame to save photos.",
          "isMediaLibraryEnabled": true,
          "granularPermissions": [],
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Gully Fame to access your photos.",
          "cameraPermission": "Allow Gully Fame to access your camera."
        }
      ],
      "@sentry/react-native",
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-video",
      "expo-web-browser",
      "./plugins/withFFMPEGResolution",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "gully-fame-india",
          "organization": "gully-fame-india"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b3d08547-d9c1-47f8-9832-8a64bb6de279"
      }
    },
    "owner": "gullyfamei"
  }
}
