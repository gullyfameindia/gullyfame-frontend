# Copy to .env (local) and fill in. Only EXPO_PUBLIC_* values are bundled into the app, so never
# put secrets here. Both URLs must be https:// (the app refuses anything else, see src/config/env.ts).

# Backend REST API. Must end with "/". Production:
EXPO_PUBLIC_API_BASE_URL=https://api.gullyfame.com/v1/api/
# Socket.IO server (chat). Production:
EXPO_PUBLIC_SOCKET_URL=https://api.gullyfame.com

# development | preview | production (tags crash reports)
EXPO_PUBLIC_ENV=development

# Optional: Sentry DSN (public identifier). Crash reporting is off when empty.
EXPO_PUBLIC_SENTRY_DSN=

# Optional: Google Sign-In web client id (public identifier).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# SENTRY_AUTH_TOKEN is a build-time secret: set it as an EAS secret, never in code or EXPO_PUBLIC_*.

# A staging backend later: set both URLs to the staging host in .env (local) or in the "preview"
# profile of eas.json, e.g. https://staging-api.gullyfame.com/v1/api/ and https://staging-api.gullyfame.com
