# Copy to .env.local and adjust. NEXT_PUBLIC_* values are bundled into the browser: never put secrets here.

# Backend REST API. Must be https:// and end with "/". Production:
NEXT_PUBLIC_API_BASE_URL=https://api.gullyfame.com/v1/api/

# Content-Security-Policy rollout (server-side, read by middleware.ts):
# CSP_ENFORCE=true           send an enforcing CSP instead of Report-Only
# CSP_MEDIA_ORIGINS=https://<bucket>.s3.<region>.amazonaws.com,https://lh3.googleusercontent.com

# A staging backend later: NEXT_PUBLIC_API_BASE_URL=https://staging-api.gullyfame.com/v1/api/
