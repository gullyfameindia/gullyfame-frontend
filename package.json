{
  "name": "gully-fame",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/gully-fame-admin",
    "apps/gully-fame-mobile",
    "apps/videoeditor"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/gully-fame-admin",
    "build": "npm run build --workspace=apps/gully-fame-admin",
    "start": "npm run start --workspace=apps/gully-fame-admin",
    "lint": "npm run lint --workspace=apps/gully-fame-admin",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "check:api": "node scripts/api-contract/check-api-contract.mjs",
    "check:api:report": "node scripts/api-contract/check-api-contract.mjs --report",
    "contract:extract": "node scripts/api-contract/extract-contract.mjs",
    "test:admin-api": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --import ./scripts/api-contract/ts-resolve.mjs apps/gully-fame-admin/lib/__tests__/http.test.mts"
  },
  "dependencies": {
    "expo": "~57.0.29",
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
